# =============================================================================
# FinPilot Environment Variables
# Copy this file to .env and fill in real values before running
# =============================================================================

# General
PROJECT_NAME=FinPilot
ENVIRONMENT=local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-min-50-char-random-string-not-for-production
JWT_SIGNING_SECRET_KEY=replace-with-separate-min-50-char-random-string-for-jwt
DJANGO_ADMIN_URL=django-admin/
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot_dev_password_change_in_prod

# JWT token lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
COOKIE_SECURE=False

# Super Admin — created by init_app (local dev only; use secrets manager in prod)
SUPER_ADMIN_EMAIL=admin@finpilot.local
SUPER_ADMIN_NAME=FinPilot Admin
SUPER_ADMIN_PASSWORD=Admin@1234!ChangeMeInProd

# Demo Viewer — created by init_app (local dev only)
DEMO_VIEWER_EMAIL=viewer@finpilot.local
DEMO_VIEWER_PASSWORD=Viewer@1234!ChangeMeInProd

# Seed data on first boot
AUTO_SEED=true

# Business logic
BUSINESS_TIME_ZONE=Asia/Kolkata
STALE_DATA_DAYS=7
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_ROWS=50000
IMPORT_AMOUNT_TOLERANCE=1.00

# Logging
LOG_LEVEL=INFO

# Security (set to True in production)
DJANGO_SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True

# Test DB overrides (optional)
TEST_POSTGRES_DB=finpilot_test
TEST_POSTGRES_HOST=
TEST_POSTGRES_PORT=
TEST_POSTGRES_USER=
TEST_POSTGRES_PASSWORD=
